<Project>
  <!-- Windows ConPty files -->
  <ItemGroup>
    <ConPtyFiles Condition="'$(PlatformTarget)' != '' And '$(PlatformTarget)' != 'AnyCPU'"
                 Include="$(MSBuildThisFileDirectory)\$(PlatformTarget)\**\*" />
  </ItemGroup>

  <Target Name="CopyPtyNativeFiles">
    <Copy SourceFiles="@(ConPtyFiles)" DestinationFiles="$(OutDir)\%(RecursiveDir)\%(FileName)%(Extension)" />
  </Target>

  <PropertyGroup>
    <PostBuildEventDependsOn>
      $(PostBuildEventDependsOn);
      CopyPtyNativeFiles;
    </PostBuildEventDependsOn>
    <BuildDependsOn>
      $(BuildDependsOn);
      CopyPtyNativeFiles;
    </BuildDependsOn>
  </PropertyGroup>

  <!-- macOS native shim library -->
  <Target Name="CopyMacOSNativeShim"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <PtyNetDir>$([System.IO.Path]::GetDirectoryName('$(MSBuildThisFileFullPath)'))</PtyNetDir>
      <NativeShimSource>$(PtyNetDir)\..\..\..\bin\Pty.Net\Debug\netstandard2.0\libpty_shim.dylib</NativeShimSource>
    </PropertyGroup>

    <Copy SourceFiles="$(NativeShimSource)"
          DestinationFolder="$(OutDir)"
          Condition="Exists('$(NativeShimSource)')"
          SkipUnchangedFiles="true" />

    <Message Importance="High"
             Text="Copied libpty_shim.dylib to $(OutDir)"
             Condition="Exists('$(NativeShimSource)')" />
  </Target>

  <!-- Linux native PTY spawn library -->
  <Target Name="CopyLinuxNativeSpawn"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <PtyNetDir>$([System.IO.Path]::GetDirectoryName('$(MSBuildThisFileFullPath)'))</PtyNetDir>
      <NativeSpawnSource>$(PtyNetDir)/../../../bin/Pty.Net/Debug/netstandard2.0/libpty_spawn_linux.so</NativeSpawnSource>
    </PropertyGroup>

    <Copy SourceFiles="$(NativeSpawnSource)"
          DestinationFolder="$(OutDir)"
          Condition="Exists('$(NativeSpawnSource)')"
          SkipUnchangedFiles="true" />

    <Message Importance="High"
             Text="Copied libpty_spawn_linux.so to $(OutDir)"
             Condition="Exists('$(NativeSpawnSource)')" />
  </Target>
</Project>
