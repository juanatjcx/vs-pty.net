<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(WinptyReleasePath)\x64\*.dll;$(WinptyReleasePath)\x64\*.exe">
      <Visible>false</Visible>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Include="$(OpenConsoleReleasePath)\x64\Release\*.dll;$(OpenConsoleReleasePath)\x64\Release\*.exe">
      <Visible>false</Visible>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <LinkBase>os64\</LinkBase>
    </None>

    <None Include="Pty.Net.targets">
      <Pack>true</Pack>
      <PackagePath>build\</PackagePath>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\OSS.Sign\OSS.Sign.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CollectNugetFiles" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <OutputPtyFiles Include="$(RepoRootPath)\bin\winpty\**\*" />
      
      <None Include="@(OutputPtyFiles)">
        <Pack>true</Pack>
        <PackagePath>build\</PackagePath>
      </None>

      <None Include="$(RepoRootPath)\bin\conpty\x86\conpty.dll">
        <Pack>true</Pack>
        <PackagePath>build\x86\os86</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x86\conpty.dll">
        <Pack>true</Pack>
        <PackagePath>build\x86\os64</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x86\OpenConsole.exe">
        <Pack>true</Pack>
        <PackagePath>build\x86\os86</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x64\OpenConsole.exe">
        <Pack>true</Pack>
        <PackagePath>build\x86\os64</PackagePath>
      </None>

      <None Include="$(RepoRootPath)\bin\conpty\x64\conpty.dll">
        <Pack>true</Pack>
        <PackagePath>build\x64\os86</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x64\conpty.dll">
        <Pack>true</Pack>
        <PackagePath>build\x64\os64</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x86\OpenConsole.exe">
        <Pack>true</Pack>
        <PackagePath>build\x64\os86</PackagePath>
      </None>
      <None Include="$(RepoRootPath)\bin\conpty\x64\OpenConsole.exe">
        <Pack>true</Pack>
        <PackagePath>build\x64\os64</PackagePath>
      </None>
    </ItemGroup>
  </Target>

  <!-- ============================================================================
       macOS native shim for ARM64 variadic ioctl workaround
       See: https://github.com/dotnet/runtime/issues/48752
       P/Invoke to variadic functions doesn't work on Apple Silicon, so we compile
       a native shim that wraps ioctl calls in non-variadic functions.
       ============================================================================ -->
  <Target Name="BuildNativeShimMacOS"
          BeforeTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <NativeShimSource>$(MSBuildThisFileDirectory)Native/pty_shim.c</NativeShimSource>
      <NativeOutputDir>$(OutputPath)runtimes/osx/native</NativeOutputDir>
      <NativeShimOutput>$(NativeOutputDir)/libpty_shim.dylib</NativeShimOutput>
    </PropertyGroup>

    <!-- Create output directory -->
    <MakeDir Directories="$(NativeOutputDir)" />

    <!-- Compile universal binary (arm64 + x86_64) for both Apple Silicon and Intel Macs -->
    <Exec Command="clang -dynamiclib -arch arm64 -arch x86_64 -install_name @rpath/libpty_shim.dylib -o '$(NativeShimOutput)' '$(NativeShimSource)'"
          Condition="!Exists('$(NativeShimOutput)')" />

    <Message Importance="High" Text="Built native shim: $(NativeShimOutput)" Condition="!Exists('$(NativeShimOutput)')" />
  </Target>

  <!-- Ensure native library is copied to consuming projects on macOS -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="$(OutputPath)runtimes/osx/native/libpty_shim.dylib"
             Condition="Exists('$(OutputPath)runtimes/osx/native/libpty_shim.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes/osx/native/libpty_shim.dylib</Link>
      <Pack>true</Pack>
      <PackagePath>runtimes/osx/native/</PackagePath>
    </Content>
  </ItemGroup>
</Project>
